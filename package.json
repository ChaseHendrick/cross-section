{
  "name": "cross-sections",
  "private": true,
  "version": "0.1.0",
  "description": "Living, hand-drawn 3D cutaways of great buildings and machines.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "serve": "python3 run/cross-sections.py --dev",
    "build": "node tools/build.js",
    "build:check": "node tools/build.js --check",
    "lint": "node tools/lint.js",
    "test": "node tools/lint.js && node tools/build.js --check",
    "test:browser": "node tools/check.cjs",
    "shot": "node tools/shot.cjs",
    "test:mobile": "node tools/check.cjs --mobile",
    "test:dist": "node tools/check.cjs --dist",
    "thumbs": "node tools/thumbs.cjs"
  },
  "dependencies": {
    "cannon-es": "0.20.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1"
  }
}
